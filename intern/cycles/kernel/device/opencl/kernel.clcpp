/* =========================================================================
 * Film Conversion Kernels
 * ========================================================================= */

__kernel void opencl_film_convert_byte_rgba(ccl_global KernelData *data,
                                             ccl_global uchar4 *destination,
                                             ccl_global float *buffer,
                                             int rgba_offset,
                                             int d_stride,
                                             int b_stride,
                                             int work_size)
{
  int g_id = get_global_id(0);
  if (g_id < work_size) {
    film_convert_byte_rgba(data, destination, buffer, rgba_offset, d_stride, b_stride, g_id);
  }
}

