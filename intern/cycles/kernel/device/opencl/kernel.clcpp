/* =========================================================================
 * Prefix Sum (Scan Parallel Primitive)
 * ========================================================================= */

__kernel void opencl_prefix_sum(ccl_global KernelData *data,
                                ccl_global int *counter,
                                ccl_global int *prefix_sum_array,
                                int num_states)
{
  int g_id = get_global_id(0);
  if (g_id < num_states) {
    prefix_sum(data, counter, prefix_sum_array, g_id);
  }
}

/* =========================================================================
 * Adaptive Sampling & Post-Processing
 * ========================================================================= */

__kernel void opencl_adaptive_sampling_convergence_check(ccl_global KernelData *data,
