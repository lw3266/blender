#define ccl_gpu
#define ccl_device inline
#define ccl_global __global
#define ccl_local __local
#define ccl_constant __constant

#include "kernel/device/gpu/kernel.h"

extern "C" {

/* =========================================================================
 * Integrator Initialization & Reset
 * ========================================================================= */

__kernel void opencl_integrator_reset(ccl_global KernelData *data,
                                       ccl_global void *state,
                                       int work_size)
{
  int g_id = get_global_id(0);
  if (g_id < work_size) {
    integrator_reset(data, state, g_id);
  }
}

__kernel void opencl_integrator_init_from_camera(ccl_global KernelData *data,
                                                  ccl_global void *state,
                                                  int work_size)
{
  int g_id = get_global_id(0);
  if (g_id < work_size) {
    integrator_init_from_camera(data, state, g_id);
  }
}

__kernel void opencl_integrator_init_from_bake(ccl_global KernelData *data,
                                                ccl_global void *state,
                                                int work_size)
{
  int g_id = get_global_id(0);
  if (g_id < work_size) {
    integrator_init_from_bake(data, state, g_id);
  }
}

